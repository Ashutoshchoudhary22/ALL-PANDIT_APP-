PORT=5300

# MySQL Database
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=app

JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
APP_URL=http://localhost:5300
NODE_ENV=development

# CORS — optional extra origins (comma-separated)
# Built-in allowlist: *.apnaacharya.com, localhost, 127.0.0.1, 192.168.x.x, 10.x.x.x
# CORS_ALLOWED_ORIGINS=https://apnaacharya.com,https://www.apnaacharya.com

# Gmail SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SERVICE=gmail
SMTP_MAIL=
SMTP_PASSWORD=
SMTP_FROM=

# Cloudinary (https://cloudinary.com/console)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
